#include <windows.h>

// build.bat regenerates build\version.h from the nearest git tag and defines
// HAVE_VERSION_H; running rc.exe by hand without it still compiles, as 0.0.0.
#ifdef HAVE_VERSION_H
#include "version.h"
#else
#define VERSION_QUAD 0,0,0,0
#define VERSION_STR "0.0.0"
#endif

// CREATEPROCESS_MANIFEST_RESOURCE_ID: embedding the manifest is what makes the
// process DPI aware and keeps it running as the invoking user.
1 RT_MANIFEST "BatteryTray.manifest"

// The tray icon is drawn at runtime, so the only icon a resource could add is
// the one Explorer shows for the .exe itself. Drop a BatteryTray.ico next to
// this file and uncomment to embed it:
// 1 ICON "BatteryTray.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VERSION_QUAD
PRODUCTVERSION VERSION_QUAD
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Battery percentage in the notification area"
            VALUE "FileVersion", VERSION_STR
            VALUE "InternalName", "BatteryTray"
            VALUE "OriginalFilename", "BatteryTray.exe"
            VALUE "ProductName", "BatteryTray"
            VALUE "ProductVersion", VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
